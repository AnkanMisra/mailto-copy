{
  "manifest_version": 3,
  "name": "mailto:copy",
  "short_name": "mailto:copy",
  "version": "1.0.0",
  "description": "Intercepts mailto links and copies the email address instead of opening an email client.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{cf105d1a-4c91-4e78-bc5a-52f01fbd831c}",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "mailto:copy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
